# --- Доступ только ограниченному кругу (опционально) ---
# Если задан хотя бы один список — LLM и ответы в чат только для «своих»; остальные сообщения игнорируются (ничего не пишем).
# ALLOWLIST_CHAT_IDS=u2i-abc123,u2i-def456
# ALLOWLIST_USER_IDS=123456789,987654321
# Если заданы ОБА списка — нужно совпадение И по чату, И по пользователю.

# --- Заявка после tool (опционально) ---
# POST JSON при успешном вызове submit_transport_lead / submit_phone_backfill (см. код TransportLeadPayload).
# SUBMIT_WEBHOOK_URL=https://your-backend.example.com/avito-lead
# SUBMIT_WEBHOOK_SECRET=  # Bearer, если нужен

# Каталог с .md базой знаний (роль агента, товар, политики). По умолчанию ./knowledge относительно cwd
# KNOWLEDGE_DIR=/absolute/path/to/knowledge

# LLM — диалог бота (OpenAI-совместимый Chat Completions API + tools)
OPENAI_API_KEY=
# Модель. Примеры:
#   OpenAI:  gpt-4.1-mini  /  gpt-4o-mini
#   Gemini:  gemini-2.0-flash  /  gemini-1.5-flash
OPENAI_MODEL=gemini-2.0-flash
# Base URL провайдера (должен заканчиваться на /v1):
#   OpenAI:  https://api.openai.com/v1  (по умолчанию)
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Avito API credentials — get them at https://www.avito.ru/professionals/api
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Your Avito user_id (numeric). Leave empty to auto-detect via API.
AVITO_USER_ID=

# Polling interval in seconds (how often to check for new messages)
POLL_INTERVAL_SEC=15

# --- Webhook mode (optional, alternative to polling) ---
# Set to "webhook" to receive messages via HTTP instead of polling.
MODE=polling

# Port for the webhook HTTP server (only used when MODE=webhook)
WEBHOOK_PORT=3000

# Public URL where Avito can reach the webhook server
# e.g. https://your-domain.com/avito/webhook
WEBHOOK_URL=

# --- 1C API ---
# Port for the REST API server (used by 1C or any external system)
API_PORT=3001

# Secret token for API authentication (Bearer token).
# Set any long random string, e.g.: openssl rand -hex 32
API_TOKEN=

# --- Phone backfill script (optional) ---
# Limit number of old chats per run
BACKFILL_LIMIT=100
# Set true to preview without sending messages
BACKFILL_DRY_RUN=false
# How many latest messages to scan in each chat
BACKFILL_SCAN_MESSAGES=100
