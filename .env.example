# Avito API credentials — get them at https://www.avito.ru/professionals/api
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Your Avito user_id (numeric). Leave empty to auto-detect via API.
AVITO_USER_ID=

# Polling interval in seconds (how often to check for new messages)
POLL_INTERVAL_SEC=15

# --- Webhook mode (optional, alternative to polling) ---
# Set to "webhook" to receive messages via HTTP instead of polling.
MODE=polling

# Port for the webhook HTTP server (only used when MODE=webhook)
WEBHOOK_PORT=3000

# Public URL where Avito can reach the webhook server
# e.g. https://your-domain.com/avito/webhook
WEBHOOK_URL=

# --- 1C API ---
# Port for the REST API server (used by 1C or any external system)
API_PORT=3001

# Secret token for API authentication (Bearer token).
# Set any long random string, e.g.: openssl rand -hex 32
API_TOKEN=
