{
  "name": "avito-messenger-bot",
  "version": "1.0.0",
  "description": "Avito messenger bot — listens to incoming messages, matches patterns, sends replies",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile=avito-bot",
    "test:chats": "bun run src/test-chats.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.9",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "typescript": "^5.8.3"
  }
}
